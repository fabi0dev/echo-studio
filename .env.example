# Echo Studio — copy to `.env` and edit. All values are optional.

# ---- Model sources --------------------------------------------------------
# Base repo (text encoder + VAE + tokenizer + scheduler).
ECHO_BASE_MODEL_ID=lodestones/Chroma1-HD

# Local path to the Q4 GGUF transformer (default: models/chroma-q4.gguf).
# You can also point straight at a HuggingFace blob URL.
# ECHO_CHROMA_GGUF=models/chroma-q4.gguf

# Where the downloader grabs the Q4 file from if it's missing.
# Swap the version/quant here (e.g. chroma-unlocked-v48 Q4_0) if you prefer.
ECHO_CHROMA_GGUF_URL=https://huggingface.co/silveroxides/Chroma-GGUF/resolve/main/Chroma1-HD/Chroma1-HD-Q4_0.gguf

# ---- Hardware -------------------------------------------------------------
# auto | cuda | mps | cpu
ECHO_DEVICE=auto
# auto | bfloat16 | float16 | float32
ECHO_DTYPE=auto
# Offload modules to CPU between steps to fit smaller VRAM (CUDA only).
ECHO_CPU_OFFLOAD=true
ECHO_VAE_TILING=true

# ---- Generation defaults / guardrails ------------------------------------
ECHO_DEFAULT_STEPS=28
ECHO_MAX_STEPS=60
ECHO_DEFAULT_GUIDANCE=3.0
ECHO_MAX_SIDE=1536
ECHO_MAX_BATCH=4

# ---- Server ---------------------------------------------------------------
ECHO_HOST=0.0.0.0
ECHO_PORT=8000
# Load the model at boot instead of on the first request.
ECHO_PRELOAD=false
# ECHO_OUTPUT_DIR=outputs
