# Echo Studio — copy to `.env` and edit. All values are optional.
# Hardware is auto-detected: CUDA → Apple MPS → DirectML → CPU.

# ---- Model sources --------------------------------------------------------
# SD 1.5 checkpoint (DreamShaper 8). No CLIP safety checker is loaded.
# ECHO_MODEL_ID=Lykon/DreamShaper
# ECHO_CHECKPOINT=models/dreamshaper-8.safetensors
ECHO_CHECKPOINT_URL=https://huggingface.co/Lykon/DreamShaper/resolve/main/DreamShaper_8_pruned.safetensors

# ---- Hardware -------------------------------------------------------------
# auto | cuda | mps | directml | cpu
ECHO_DEVICE=auto
# DirectML adapter: auto (prefer dedicated GPU) | 0 | 1 | 6600 | RX 6600
ECHO_DML_DEVICE=auto
# auto | bfloat16 | float16 | float32
ECHO_DTYPE=auto
ECHO_CPU_OFFLOAD=true
ECHO_VAE_TILING=true
ECHO_CLIP_SKIP=2

# ---- Generation defaults / guardrails ------------------------------------
ECHO_DEFAULT_STEPS=20
ECHO_MAX_STEPS=60
ECHO_DEFAULT_GUIDANCE=7.0
ECHO_MAX_SIDE=768
ECHO_MAX_BATCH=4

# ---- Server ---------------------------------------------------------------
ECHO_HOST=0.0.0.0
ECHO_PORT=8000
ECHO_PRELOAD=false
